# =============================================================
# SaaS Proxy — environment template
# Copy to .env and fill in real values. NEVER commit the .env file.
# =============================================================

# --- REQUIRED in production ---
# 32+ char random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Token required for /api/admin/* and /admin UI.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --- Payment (USDT-TRC20) ---
# Your receive-only TRC20 wallet address (must start with T, 34 chars).
USDT_TRC20_ADDRESS=
# Display name shown on the deposit screen
PAYMENT_EXCHANGE_NAME=XT.com
PAYMENT_RATE=1
# Minimum deposit enforced everywhere (data entry + AutoPay polling)
MIN_DEPOSIT_USDT=10
# Trongrid endpoint + optional API key (higher rate limits)
TRON_API_BASE=https://api.trongrid.io
TRONGRID_API_KEY=
# AutoPay poll interval (ms) and how many txs to scan per poll
AUTO_PAY_POLL_MS=30000
AUTO_PAY_LOOKBACK_LIMIT=20

# --- AntiRed domain pool (comma separated) ---
# All AntiRed uplinks rotate randomly through this list. Setting ANY value
# here takes priority over per-user admin-managed domains.
# ANTIRED_ROTATOR_DOMAINS is preferred, ANTIRED_DOMAINS is supported for legacy.
ANTIRED_ROTATOR_DOMAINS=
ANTIRED_DOMAINS=

# --- Telegram bot (visit notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram bot (interactive / webhook mode) ---
# Username of the bot without @ (used to build t.me deep links).
TELEGRAM_BOT_USERNAME=
# Public base URL of THIS server — Telegram will POST updates here.
# Must be HTTPS in production. Example: https://proxy.example.com
PUBLIC_BASE_URL=
# Shared secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# Recommended. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Optional overrides (defaults shown)
# TELEGRAM_ADMIN_TTL_MS=1800000
# TELEGRAM_LINK_TTL_MS=600000
# Idle poll interval when there is no pending work (ms; default 300000 = 5 min)
AUTO_PAY_POLL_IDLE_MS=300000

# --- Misc ---
NODE_ENV=production
PORT=3000
